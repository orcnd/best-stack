package corefast

import (
	"strings"

	"bestack/go/core"
)

templ kanbanPage(p Page, vm BoardVM) {
	@layout(p) {
		<div if p.FE == "alpine" { x-data={ "kanban(" + itoa(vm.Board.ID) + ")" } }>
			<div class="board-head">
				<h1>{ vm.Board.Name }</h1>
				<nav class="board-tabs" data-testid="board-select">
					for _, s := range vm.Boards {
						<a href={ templ.SafeURL(p.Base + "/kanban/" + itoa(s.ID)) } if s.ID == vm.Board.ID { class="active" }>{ s.Name }</a>
					}
				</nav>
			</div>
			<form
				class="new-card"
				method="post"
				action={ templ.SafeURL(p.Base + "/kanban/" + itoa(vm.Board.ID) + "/cards") }
				if p.FE == "htmx" {
					hx-post={ p.Base + "/kanban/" + itoa(vm.Board.ID) + "/cards" }
					hx-target="#board"
					hx-swap="outerHTML"
					hx-on::after-request="if (event.detail.successful) this.reset()"
				}
				if p.FE == "alpine" {
					@submit.prevent="create($event.target)"
				}
			>
				<input type="text" name="title" maxlength="200" required placeholder="Yeni kart başlığı" data-testid="new-card-input"/>
				<input type="hidden" name="column" value="backlog"/>
				<button type="submit" data-testid="new-card-submit">Kart ekle</button>
			</form>
			@board(p.FE, p.Base, vm.Board)
		</div>
	}
}

templ board(fe, base string, b core.Board) {
	<div
		class="board"
		id="board"
		if fe == "htmx" {
			hx-target="#board"
			hx-swap="outerHTML"
		}
		if fe == "alpine" {
			x-show="!ready"
		}
	>
		for i, k := range core.Columns {
			<section class="column" data-testid={ "column-" + k }>
				<h2>{ core.ColumnLabels[k] } <span class="count">{ itoa(int64(len(b.Columns[k]))) }</span></h2>
				if len(b.Columns[k]) > 0 {
					<ul class="cards">
						for _, c := range b.Columns[k] {
							@card(fe, base, c, i == 0, i == len(core.Columns)-1)
						}
					</ul>
				} else {
					<p class="empty" data-testid="empty-state">Kart yok.</p>
				}
			</section>
		}
	</div>
	if fe == "alpine" {
		@alpineBoardClient()
	}
}

templ card(fe, base string, c core.Card, first, last bool) {
	<li class="card" data-testid="card" data-card-id={ itoa(c.ID) }>
		<form
			class="title-form"
			method="post"
			action={ templ.SafeURL(base + "/kanban/cards/" + itoa(c.ID)) }
			if fe == "htmx" {
				hx-post={ base + "/kanban/cards/" + itoa(c.ID) }
			}
			if fe == "alpine" {
				@submit.prevent={ "update(" + itoa(c.ID) + ", { title: $event.target.elements.title.value })" }
			}
		>
			<input class="card-title" type="text" name="title" value={ c.Title } maxlength="200" data-testid="card-title"/>
			<button type="submit" class="small" data-testid="card-edit">Kaydet</button>
		</form>
		<p class="card-meta"><span class="labels">{ strings.Join(c.Labels, ", ") }</span> <span class="assignee">{ c.Assignee }</span> <span class="due">{ c.DueDate }</span></p>
		<div class="card-actions">
			if fe == "alpine" {
				@alpineMoveForm(c.ID, "left", first)
			} else {
				<form
					method="post"
					action={ templ.SafeURL(base + "/kanban/cards/" + itoa(c.ID)) }
					if fe == "htmx" {
						hx-post={ base + "/kanban/cards/" + itoa(c.ID) }
					}
				><input type="hidden" name="move" value="left"/><button type="submit" class="small" data-testid="card-move-left" disabled?={ first }>←</button></form>
			}
			if fe == "alpine" {
				@alpineMoveForm(c.ID, "right", last)
			} else {
				<form
					method="post"
					action={ templ.SafeURL(base + "/kanban/cards/" + itoa(c.ID)) }
					if fe == "htmx" {
						hx-post={ base + "/kanban/cards/" + itoa(c.ID) }
					}
				><input type="hidden" name="move" value="right"/><button type="submit" class="small" data-testid="card-move-right" disabled?={ last }>→</button></form>
			}
			<form
				method="post"
				action={ templ.SafeURL(base + "/kanban/cards/" + itoa(c.ID)) }
				if fe == "htmx" {
					hx-post={ base + "/kanban/cards/" + itoa(c.ID) }
				}
				if fe == "alpine" {
					@submit.prevent={ "remove(" + itoa(c.ID) + ")" }
				}
			><input type="hidden" name="delete" value="1"/><button type="submit" class="small danger" data-testid="card-delete">Sil</button></form>
		</div>
	</li>
}
