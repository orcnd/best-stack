{
  "name": "best-stack-sveltekit",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "mkdir -p static/static && cp ../../shared/static/app.css static/static/ && cp -R ../../shared/static/img static/static/",
    "build": "bun run assets && ../runtime/node_modules/.bin/bun --bun vite build",
    "start": "../runtime/node_modules/.bin/bun build/index.js",
    "test": "bun test src"
  },
  "devDependencies": {
    "@sveltejs/adapter-bun": "1.0.1",
    "@sveltejs/kit": "3.3.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.58.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*.ts"
  }
}